{
  "name": "filspay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck && tsc -p db --noEmit && tsc -p scripts --noEmit",
    "test": "bun run --filter '*' test && bun test scripts/",
    "migrate": "bun db/migrate.ts",
    "seed": "bun db/seed/index.ts"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/pg": "^8.11.6",
    "typescript": "^5.6.3",
    "tsx": "^4.19.1"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
